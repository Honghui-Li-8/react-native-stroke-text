{
  "name": "react-native-stroke-text-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo for React Native Stroke Text package and example app",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=packages/stroke-text",
    "example:start": "npm run start --workspace=examples/example",
    "example:android": "npm run android --workspace=examples/example",
    "example:ios": "npm run ios --workspace=examples/example"
  },
  "devDependencies": {
    "expo": "~54.0.0",
    "prettier": "^2.8.5"
  },
  "engines": {
    "node": ">=14"
  }
}
