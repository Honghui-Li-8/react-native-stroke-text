{
  "name": "@charmy.tech/react-native-stroke-text",
  "version": "1.3.0",
  "description": "React Native Stroke/Outline Text",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "typings": "build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    }
  },
  "source": "./src/",
  "author": "Charmy Inc. (https://github.com/charmy)",
  "license": "MIT",
  "homepage": "https://github.com/charmy/react-native-stroke-text#readme",
  "repository": "https://github.com/charmy/react-native-stroke-text",
  "bugs": {
    "url": "https://github.com/charmy/react-native-stroke-text"
  },
  "keywords": [
    "react-native",
    "stroke",
    "text",
    "outline"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "yarn build",
    "prepublishOnly": "yarn build"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-native": ">=0.81.0"
  },
  "react-native": {
    "codegenConfig": {
      "name": "StrokeTextView",
      "type": "components",
      "jsSrcsDir": "./src"
    }
  },
  "devDependencies": {
    "@babel/core": "^7.21.3",
    "@babel/runtime": "^7.21.0",
    "@types/node": "^18.15.3",
    "@types/react": "^18.2.0",
    "prettier": "^2.8.5",
    "typescript": "^5.0.2"
  },
  "dependencies": {
    "react": "19.1.0",
    "react-native": "0.81.5"
  }
}
